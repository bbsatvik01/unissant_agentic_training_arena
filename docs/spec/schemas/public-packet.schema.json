{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unissant-arena.invalid/schemas/public-packet.schema.json",
  "title": "Public case packet",
  "description": "SCN-7, schema v1.1. Everything an investigator, the interviewer harness and an assistant candidate may see before any record is released. Identical across the truthful and deceptive variants of a family except for case_id (S1 section 4.1, rule L1), so the presentation, the opening question and the replay topics are shared by both variants. Contains no role, no fact IDs, no release schedule, no scheduled-record contents and no style or demeanor attribute (PRB-4, C-22).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "packet",
    "case_id",
    "domain",
    "title",
    "difficulty_level",
    "investigation_objective",
    "interview_context",
    "presentation",
    "opening_question",
    "replay_topics",
    "known_timeline",
    "initial_documents",
    "requestable_records",
    "limits",
    "ground_rules"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1.0"
    },
    "packet": {
      "const": "public"
    },
    "case_id": {
      "$ref": "#/$defs/caseId"
    },
    "domain": {
      "$ref": "#/$defs/domain"
    },
    "title": {
      "type": "string",
      "minLength": 5,
      "maxLength": 120
    },
    "difficulty_level": {
      "$ref": "#/$defs/difficultyLevel"
    },
    "investigation_objective": {
      "type": "string",
      "minLength": 20,
      "maxLength": 600
    },
    "interview_context": {
      "$ref": "#/$defs/interviewContext"
    },
    "presentation": {
      "description": "How the subject appears in the room (S6 6.4) and sounds in a voice session (S2 9.2). Assigned per family, so both variants carry the same object and it cannot correlate with role. No demeanor or style attribute (C-22).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "persona_id",
        "display_name",
        "voice_id"
      ],
      "properties": {
        "persona_id": {
          "description": "Portrait from the art pool (S6 6.4, WP-21), drawn by the seed sampler (S1 8.1). The pool is made from neutral descriptions with no case content.",
          "type": "string",
          "pattern": "^persona-[0-9]{2,3}$"
        },
        "display_name": {
          "description": "Equals interview_context.subject.name (validator V2).",
          "type": "string",
          "minLength": 3,
          "maxLength": 80
        },
        "voice_id": {
          "description": "Prebuilt Gemini Live voice name (voice_name), drawn by the seed sampler. arena-subject checks it against the voices the day-1 Live probe confirms.",
          "type": "string",
          "pattern": "^[A-Z][a-z]{2,19}$"
        }
      }
    },
    "opening_question": {
      "description": "BKO-7 common initial question, asked first in every trial of this case (S2 8.1). Written by the generator from public material only; passes S2 relay_test.v1 at generation (validator V1c).",
      "type": "string",
      "minLength": 10,
      "maxLength": 300
    },
    "replay_topics": {
      "description": "Exactly three noun phrases of at most 12 words, rendered into the replay script (S2 8.6). Public material only; every rendered script question passes S2 relay_test.v1 (validator V1c).",
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 120,
        "pattern": "^[^\\s?]+( [^\\s?]+){0,11}$"
      }
    },
    "known_timeline": {
      "type": "array",
      "minItems": 2,
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/timelineEntry"
      }
    },
    "initial_documents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/initialDocument"
      }
    },
    "requestable_records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/requestableRecord"
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_exchanges",
        "max_releases"
      ],
      "properties": {
        "max_exchanges": {
          "const": 12
        },
        "max_releases": {
          "const": 6
        }
      }
    },
    "ground_rules": {
      "description": "EX-4, verbatim. Shown in the room, debriefs and leaderboards.",
      "const": [
        "All cases are synthetic.",
        "Evasive wording alone does not prove a violation.",
        "A simulated score is not a finding about a real person."
      ]
    }
  },
  "$defs": {
    "caseId": {
      "description": "Opaque per-variant identifier (Crockford base32). Never encodes family, variant or role.",
      "type": "string",
      "pattern": "^C-[0-9A-HJKMNP-TV-Z]{8}$"
    },
    "domain": {
      "enum": [
        "facility_access"
      ]
    },
    "difficultyLevel": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "exchange": {
      "description": "Exchange number t in 1..12 (BKO-8 cap). Exchange t is question Q(t) and answer A(t).",
      "type": "integer",
      "minimum": 1,
      "maximum": 12
    },
    "localDateTime": {
      "description": "Facility-local time, no offset; the zone is interview_context.timezone.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2})?$"
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "initialDocId": {
      "type": "string",
      "pattern": "^doc-0[1-4]$"
    },
    "artifactId": {
      "type": "string",
      "pattern": "^(doc-0[1-4]|rec-0[1-6])$"
    },
    "artifactKind": {
      "enum": [
        "access_exception_report",
        "badge_log",
        "door_log",
        "sensor_metadata",
        "camera_metadata",
        "camera_status",
        "alarm_log",
        "monitor_alert",
        "dispatch_log",
        "work_order",
        "staffing_note",
        "visitor_register",
        "lockbox_log",
        "credential_record",
        "access_change_notice",
        "incident_ticket",
        "seal_audit",
        "witness_statement",
        "supervisor_statement",
        "email",
        "policy_excerpt",
        "procedure_excerpt",
        "facilities_notice",
        "clarification",
        "context_change"
      ]
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "columns",
        "rows"
      ],
      "properties": {
        "columns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          }
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "string",
              "maxLength": 200
            }
          }
        }
      }
    },
    "content": {
      "description": "Document body as plain text, plus an optional table. Synthetic and fictional only.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "body"
      ],
      "properties": {
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "table": {
          "$ref": "#/$defs/table"
        }
      }
    },
    "interviewContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agency",
        "facility",
        "timezone",
        "interview_date",
        "setting",
        "investigator_role",
        "subject",
        "purpose_statement"
      ],
      "properties": {
        "agency": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120
        },
        "facility": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120
        },
        "timezone": {
          "type": "string",
          "minLength": 3,
          "maxLength": 40
        },
        "interview_date": {
          "$ref": "#/$defs/date"
        },
        "setting": {
          "type": "string",
          "minLength": 10,
          "maxLength": 300
        },
        "investigator_role": {
          "type": "string",
          "minLength": 5,
          "maxLength": 160
        },
        "subject": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "position",
            "unit",
            "tenure_years"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 3,
              "maxLength": 80
            },
            "position": {
              "type": "string",
              "minLength": 3,
              "maxLength": 80
            },
            "unit": {
              "type": "string",
              "minLength": 3,
              "maxLength": 80
            },
            "tenure_years": {
              "type": "integer",
              "minimum": 0,
              "maximum": 45
            }
          }
        },
        "purpose_statement": {
          "description": "What the investigator tells the subject at the start (non-accusatory).",
          "type": "string",
          "minLength": 20,
          "maxLength": 400
        }
      }
    },
    "timelineEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "time",
        "event",
        "source"
      ],
      "properties": {
        "time": {
          "$ref": "#/$defs/localDateTime"
        },
        "event": {
          "type": "string",
          "minLength": 5,
          "maxLength": 240
        },
        "source": {
          "$ref": "#/$defs/initialDocId"
        }
      }
    },
    "initialDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "doc_id",
        "kind",
        "title",
        "content"
      ],
      "properties": {
        "doc_id": {
          "$ref": "#/$defs/initialDocId"
        },
        "kind": {
          "$ref": "#/$defs/artifactKind"
        },
        "title": {
          "type": "string",
          "minLength": 5,
          "maxLength": 120
        },
        "content": {
          "$ref": "#/$defs/content"
        }
      }
    },
    "requestableRecord": {
      "description": "A record the investigator may request by ID once requestable_after_exchanges exchanges are complete. Title and description are role-neutral and identical across variants; contents are released only by release_evidence(). Scheduled records are never listed here; they appear when released.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "kind",
        "title",
        "description",
        "requestable_after_exchanges"
      ],
      "properties": {
        "record_id": {
          "$ref": "#/$defs/recordId"
        },
        "kind": {
          "$ref": "#/$defs/artifactKind"
        },
        "title": {
          "type": "string",
          "minLength": 5,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "minLength": 10,
          "maxLength": 300
        },
        "requestable_after_exchanges": {
          "$ref": "#/$defs/completedExchanges"
        },
        "date": {
          "description": "Optional date of the record, used by the replay evidence slot (S2 8.6) and the evidence board (S6). Set only when the title does not already carry it.",
          "$ref": "#/$defs/date"
        }
      }
    },
    "completedExchanges": {
      "description": "Number of completed exchanges (0..10). release_evidence() runs between exchanges, after the answer is committed and before the next question (S4 sql/0004), so a predicate value of n acts once n exchanges are complete and the release is visible before question n+1. At most 10, so at least two questions remain.",
      "type": "integer",
      "minimum": 0,
      "maximum": 10
    },
    "recordId": {
      "description": "Releasable record (requestable or scheduled). Format shared with S2 (rec-NN).",
      "type": "string",
      "pattern": "^rec-0[1-6]$"
    }
  }
}
