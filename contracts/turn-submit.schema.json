{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unissant-arena.invalid/contracts/turn-submit.schema.json",
  "title": "TurnSubmit",
  "additionalProperties": false,
  "properties": {
    "question": {
      "maxLength": 600,
      "minLength": 1,
      "type": "string"
    },
    "release_ids": {
      "items": {
        "pattern": "^rec-0[1-6]$",
        "type": "string"
      },
      "maxItems": 6,
      "type": "array",
      "uniqueItems": true
    },
    "expected_version": {
      "minimum": 0,
      "type": "integer"
    },
    "idem_key": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    }
  },
  "required": [
    "question",
    "release_ids",
    "expected_version",
    "idem_key"
  ],
  "type": "object"
}
