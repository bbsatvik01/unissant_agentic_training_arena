{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unissant-arena.invalid/contracts/tournament-card.schema.json",
  "title": "TournamentWireCard",
  "$defs": {
    "CardValidation": {
      "additionalProperties": false,
      "properties": {
        "valid": {
          "type": "boolean"
        },
        "flags": {
          "additionalProperties": false,
          "maxProperties": 3,
          "patternProperties": {
            "^t(0[1-9]|1[0-2])\\.f[1-3]$": {
              "$ref": "#/$defs/FlagCheck"
            }
          },
          "type": "object"
        },
        "demeanor_in_rationale": {
          "type": "boolean"
        }
      },
      "required": [
        "valid",
        "flags",
        "demeanor_in_rationale"
      ],
      "title": "CardValidation",
      "type": "object"
    },
    "FlagCheck": {
      "additionalProperties": false,
      "properties": {
        "citation_ok": {
          "type": "boolean"
        },
        "demeanor_based": {
          "type": "boolean"
        },
        "duplicate": {
          "type": "boolean"
        }
      },
      "required": [
        "citation_ok",
        "demeanor_based",
        "duplicate"
      ],
      "title": "FlagCheck",
      "type": "object"
    },
    "FollowUp": {
      "additionalProperties": false,
      "properties": {
        "question": {
          "maxLength": 300,
          "minLength": 1,
          "type": "string"
        },
        "tactic": {
          "enum": [
            "account_first_open",
            "funnel_probe",
            "evidence_topic",
            "evidence_source_vague",
            "evidence_specific",
            "unanticipated_detail",
            "reverse_order",
            "verifiable_detail",
            "clarify_contradiction",
            "alternative_explanation",
            "corroboration_request",
            "summary_check"
          ],
          "type": "string"
        },
        "purpose": {
          "maxLength": 160,
          "minLength": 1,
          "type": "string"
        },
        "record_request": {
          "anyOf": [
            {
              "pattern": "^rec-0[1-6]$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "question",
        "tactic",
        "purpose",
        "record_request"
      ],
      "title": "FollowUp",
      "type": "object"
    },
    "Question": {
      "additionalProperties": false,
      "properties": {
        "question_type": {
          "enum": [
            "open",
            "probing",
            "closed",
            "leading",
            "suggestive",
            "compound",
            "forced_choice",
            "opinion"
          ],
          "type": "string"
        },
        "neutrality_issues": {
          "items": {
            "enum": [
              "presupposes_fact",
              "accusatory_wording",
              "demeanor_reference",
              "multiple_questions",
              "limits_options",
              "solicits_opinion",
              "emotionally_loaded",
              "pressure_or_inducement"
            ],
            "type": "string"
          },
          "maxItems": 4,
          "type": "array"
        },
        "assessment": {
          "description": "One sentence on the question",
          "maxLength": 160,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "question_type",
        "neutrality_issues",
        "assessment"
      ],
      "title": "Question",
      "type": "object"
    },
    "StoredFinding": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "enum": [
            "deceptive",
            "truthful",
            "insufficient_evidence"
          ],
          "type": "string"
        },
        "likelihood": {
          "enum": [
            "almost_no_chance",
            "very_unlikely",
            "unlikely",
            "roughly_even_chance",
            "likely",
            "very_likely",
            "almost_certain"
          ],
          "type": "string"
        },
        "confidence": {
          "enum": [
            "low",
            "moderate",
            "high"
          ],
          "type": "string"
        },
        "basis_flag_refs": {
          "items": {
            "pattern": "^t(0[1-9]|1[0-2])\\.f[1-3]$",
            "type": "string"
          },
          "maxItems": 6,
          "type": "array"
        },
        "cited_turns": {
          "items": {
            "maximum": 12,
            "minimum": 1,
            "type": "integer"
          },
          "maxItems": 12,
          "type": "array"
        },
        "cited_records": {
          "items": {
            "pattern": "^(doc-0[1-4]|rec-0[1-6])$",
            "type": "string"
          },
          "maxItems": 10,
          "type": "array"
        },
        "corroboration_needed": {
          "items": {
            "maxLength": 120,
            "minLength": 3,
            "type": "string"
          },
          "maxItems": 3,
          "type": "array"
        },
        "rationale": {
          "maxLength": 600,
          "minLength": 1,
          "type": "string"
        },
        "alternative_explanations": {
          "anyOf": [
            {
              "items": {
                "maxLength": 160,
                "minLength": 3,
                "type": "string"
              },
              "maxItems": 3,
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_revised_turn": {
          "anyOf": [
            {
              "maximum": 12,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "label",
        "likelihood",
        "confidence",
        "basis_flag_refs",
        "cited_turns",
        "cited_records",
        "corroboration_needed",
        "rationale",
        "alternative_explanations",
        "last_revised_turn"
      ],
      "title": "StoredFinding",
      "type": "object"
    },
    "StoredFlag": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "gap",
            "non_responsive",
            "possible_evasion",
            "contradiction",
            "evidence_conflict"
          ],
          "type": "string"
        },
        "turn_id": {
          "pattern": "^t(0[1-9]|1[0-2])$",
          "type": "string"
        },
        "quote": {
          "description": "Exact span of the subject's answer in turn_id",
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        "missing_fact": {
          "anyOf": [
            {
              "maxLength": 120,
              "minLength": 3,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "conflict_turn_id": {
          "anyOf": [
            {
              "pattern": "^t(0[1-9]|1[0-2])$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "conflict_quote": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "conflict_record_id": {
          "anyOf": [
            {
              "pattern": "^(doc-0[1-4]|rec-0[1-6])$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "conflict_record_quote": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "flag_ref": {
          "pattern": "^t(0[1-9]|1[0-2])\\.f[1-3]$",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "turn_id",
        "quote",
        "missing_fact",
        "conflict_turn_id",
        "conflict_quote",
        "conflict_record_id",
        "conflict_record_quote",
        "flag_ref"
      ],
      "title": "StoredFlag",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "enum": [
        "card.v1"
      ],
      "type": "string"
    },
    "turn_id": {
      "pattern": "^t(0[1-9]|1[0-2])$",
      "type": "string"
    },
    "question": {
      "$ref": "#/$defs/Question"
    },
    "answer_category": {
      "enum": [
        "responsive",
        "non_responsive",
        "contradiction",
        "explicit_uncertainty",
        "possible_evasion"
      ],
      "type": "string"
    },
    "flags": {
      "items": {
        "$ref": "#/$defs/StoredFlag"
      },
      "maxItems": 3,
      "type": "array"
    },
    "follow_up": {
      "$ref": "#/$defs/FollowUp"
    },
    "finding": {
      "$ref": "#/$defs/StoredFinding"
    },
    "boundary_notice": {
      "type": "boolean"
    },
    "commit_requested": {
      "type": "boolean"
    },
    "card_seq": {
      "minimum": 1,
      "type": "integer"
    },
    "turn_no": {
      "maximum": 12,
      "minimum": 1,
      "type": "integer"
    },
    "validation": {
      "$ref": "#/$defs/CardValidation"
    },
    "latency_ms": {
      "minimum": 0,
      "type": "integer"
    },
    "work_item": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "transcript_version": {
      "minimum": 0,
      "type": "integer"
    },
    "candidate_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "candidate_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "turn_id",
    "question",
    "answer_category",
    "flags",
    "follow_up",
    "finding",
    "boundary_notice",
    "commit_requested",
    "card_seq",
    "turn_no",
    "validation",
    "latency_ms",
    "work_item",
    "transcript_version",
    "candidate_sha256",
    "candidate_id"
  ],
  "type": "object"
}
