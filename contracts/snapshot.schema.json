{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unissant-arena.invalid/contracts/snapshot.schema.json",
  "title": "TrialSnapshot",
  "$defs": {
    "CardValidation": {
      "additionalProperties": false,
      "properties": {
        "valid": {
          "type": "boolean"
        },
        "flags": {
          "additionalProperties": false,
          "maxProperties": 3,
          "patternProperties": {
            "^t(0[1-9]|1[0-2])\\.f[1-3]$": {
              "$ref": "#/$defs/FlagCheck"
            }
          },
          "type": "object"
        },
        "demeanor_in_rationale": {
          "type": "boolean"
        }
      },
      "required": [
        "valid",
        "flags",
        "demeanor_in_rationale"
      ],
      "title": "CardValidation",
      "type": "object"
    },
    "CoachCard": {
      "additionalProperties": false,
      "properties": {
        "turn_no": {
          "maximum": 12,
          "minimum": 1,
          "type": "integer"
        },
        "card": {
          "$ref": "#/$defs/TrainingWireCard"
        }
      },
      "required": [
        "turn_no",
        "card"
      ],
      "title": "CoachCard",
      "type": "object"
    },
    "CoachFailed": {
      "additionalProperties": false,
      "properties": {
        "turn_no": {
          "maximum": 12,
          "minimum": 1,
          "type": "integer"
        },
        "reason": {
          "enum": [
            "timeout",
            "repair_failed"
          ],
          "type": "string"
        }
      },
      "required": [
        "turn_no",
        "reason"
      ],
      "title": "CoachFailed",
      "type": "object"
    },
    "CoachUpdate": {
      "additionalProperties": false,
      "properties": {
        "turn_no": {
          "maximum": 12,
          "minimum": 1,
          "type": "integer"
        },
        "update": {
          "$ref": "#/$defs/StoredDeepUpdate"
        }
      },
      "required": [
        "turn_no",
        "update"
      ],
      "title": "CoachUpdate",
      "type": "object"
    },
    "Content": {
      "additionalProperties": false,
      "properties": {
        "body": {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        },
        "table": {
          "anyOf": [
            {
              "$ref": "#/$defs/TableContent"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "body"
      ],
      "title": "Content",
      "type": "object"
    },
    "CoverageEntry": {
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "pattern": "^rec-0[1-6]$",
          "type": "string"
        },
        "status": {
          "enum": [
            "not_yet_raised",
            "raised_not_tested",
            "consistent_with_account",
            "conflicts_with_account",
            "explained_innocently"
          ],
          "type": "string"
        },
        "turn_ids": {
          "items": {
            "pattern": "^t(0[1-9]|1[0-2])$",
            "type": "string"
          },
          "maxItems": 4,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "record_id",
        "status",
        "turn_ids"
      ],
      "title": "CoverageEntry",
      "type": "object"
    },
    "DisclosurePlan": {
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "anyOf": [
            {
              "pattern": "^rec-0[1-6]$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "step": {
          "enum": [
            "hold",
            "evidence_topic",
            "evidence_source_vague",
            "evidence_specific"
          ],
          "type": "string"
        }
      },
      "required": [
        "record_id",
        "step"
      ],
      "title": "DisclosurePlan",
      "type": "object"
    },
    "FlagCheck": {
      "additionalProperties": false,
      "properties": {
        "citation_ok": {
          "type": "boolean"
        },
        "demeanor_based": {
          "type": "boolean"
        },
        "duplicate": {
          "type": "boolean"
        }
      },
      "required": [
        "citation_ok",
        "demeanor_based",
        "duplicate"
      ],
      "title": "FlagCheck",
      "type": "object"
    },
    "FollowUp": {
      "additionalProperties": false,
      "properties": {
        "question": {
          "maxBytes": 600,
          "maxLength": 300,
          "minLength": 1,
          "type": "string"
        },
        "tactic": {
          "enum": [
            "account_first_open",
            "funnel_probe",
            "evidence_topic",
            "evidence_source_vague",
            "evidence_specific",
            "unanticipated_detail",
            "reverse_order",
            "verifiable_detail",
            "clarify_contradiction",
            "alternative_explanation",
            "corroboration_request",
            "summary_check"
          ],
          "type": "string"
        },
        "purpose": {
          "maxBytes": 320,
          "maxLength": 160,
          "minLength": 1,
          "type": "string"
        },
        "record_request": {
          "anyOf": [
            {
              "pattern": "^rec-0[1-6]$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "question",
        "tactic",
        "purpose",
        "record_request"
      ],
      "title": "FollowUp",
      "type": "object"
    },
    "OpenGap": {
      "additionalProperties": false,
      "properties": {
        "missing_fact": {
          "maxBytes": 240,
          "maxLength": 120,
          "minLength": 3,
          "type": "string"
        },
        "first_seen_turn": {
          "pattern": "^t(0[1-9]|1[0-2])$",
          "type": "string"
        }
      },
      "required": [
        "missing_fact",
        "first_seen_turn"
      ],
      "title": "OpenGap",
      "type": "object"
    },
    "Question": {
      "additionalProperties": false,
      "properties": {
        "question_type": {
          "enum": [
            "open",
            "probing",
            "closed",
            "leading",
            "suggestive",
            "compound",
            "forced_choice",
            "opinion"
          ],
          "type": "string"
        },
        "neutrality_issues": {
          "items": {
            "enum": [
              "presupposes_fact",
              "accusatory_wording",
              "demeanor_reference",
              "multiple_questions",
              "limits_options",
              "solicits_opinion",
              "emotionally_loaded",
              "pressure_or_inducement"
            ],
            "type": "string"
          },
          "maxItems": 4,
          "type": "array",
          "uniqueItems": true
        },
        "assessment": {
          "description": "One sentence on the question",
          "maxBytes": 320,
          "maxLength": 160,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "question_type",
        "neutrality_issues",
        "assessment"
      ],
      "title": "Question",
      "type": "object"
    },
    "RequestableRecord": {
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "pattern": "^rec-0[1-6]$",
          "type": "string"
        },
        "kind": {
          "enum": [
            "access_exception_report",
            "badge_log",
            "door_log",
            "sensor_metadata",
            "camera_metadata",
            "camera_status",
            "alarm_log",
            "monitor_alert",
            "dispatch_log",
            "work_order",
            "staffing_note",
            "visitor_register",
            "lockbox_log",
            "credential_record",
            "access_change_notice",
            "incident_ticket",
            "seal_audit",
            "witness_statement",
            "supervisor_statement",
            "email",
            "policy_excerpt",
            "procedure_excerpt",
            "facilities_notice",
            "clarification",
            "context_change"
          ],
          "type": "string"
        },
        "title": {
          "maxLength": 120,
          "minLength": 5,
          "type": "string"
        },
        "description": {
          "maxLength": 300,
          "minLength": 10,
          "type": "string"
        },
        "requestable_after_exchanges": {
          "maximum": 12,
          "minimum": 0,
          "type": "integer"
        },
        "date": {
          "anyOf": [
            {
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "record_id",
        "kind",
        "title",
        "description",
        "requestable_after_exchanges",
        "date"
      ],
      "title": "RequestableRecord",
      "type": "object"
    },
    "SnapshotRelease": {
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "pattern": "^rec-0[1-6]$",
          "type": "string"
        },
        "title": {
          "maxLength": 120,
          "minLength": 5,
          "type": "string"
        },
        "kind": {
          "enum": [
            "record",
            "clarification",
            "context_change"
          ],
          "type": "string"
        },
        "doc_kind": {
          "anyOf": [
            {
              "enum": [
                "access_exception_report",
                "badge_log",
                "door_log",
                "sensor_metadata",
                "camera_metadata",
                "camera_status",
                "alarm_log",
                "monitor_alert",
                "dispatch_log",
                "work_order",
                "staffing_note",
                "visitor_register",
                "lockbox_log",
                "credential_record",
                "access_change_notice",
                "incident_ticket",
                "seal_audit",
                "witness_statement",
                "supervisor_statement",
                "email",
                "policy_excerpt",
                "procedure_excerpt",
                "facilities_notice",
                "clarification",
                "context_change"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "date": {
          "anyOf": [
            {
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "content": {
          "$ref": "#/$defs/Content"
        },
        "released_at_turn": {
          "maximum": 12,
          "minimum": 0,
          "type": "integer"
        },
        "trigger": {
          "enum": [
            "scheduled",
            "requested"
          ],
          "type": "string"
        },
        "transcript_version": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "record_id",
        "title",
        "kind",
        "doc_kind",
        "date",
        "content",
        "released_at_turn",
        "trigger",
        "transcript_version"
      ],
      "title": "SnapshotRelease",
      "type": "object"
    },
    "SnapshotTurn": {
      "additionalProperties": false,
      "properties": {
        "turn_no": {
          "maximum": 12,
          "minimum": 1,
          "type": "integer"
        },
        "question": {
          "maxLength": 600,
          "minLength": 1,
          "type": "string"
        },
        "source": {
          "enum": [
            "investigator",
            "harness_fixed",
            "harness_fallback",
            "assistant_relay"
          ],
          "type": "string"
        },
        "answer": {
          "anyOf": [
            {
              "maxLength": 900,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "partial": {
          "type": "boolean"
        },
        "committed_at": {
          "anyOf": [
            {
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|[+-][0-9]{2}:[0-9]{2})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "answer_version": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "turn_no",
        "question",
        "source",
        "answer",
        "partial",
        "committed_at",
        "answer_version"
      ],
      "title": "SnapshotTurn",
      "type": "object"
    },
    "StoredDeepUpdate": {
      "additionalProperties": false,
      "allOf": [
        {
          "properties": {
            "finding": {
              "properties": {
                "last_revised_turn": {
                  "type": "integer"
                },
                "alternative_explanations": {
                  "type": "null"
                }
              },
              "type": "object"
            }
          }
        },
        {
          "if": {
            "properties": {
              "finding": {
                "properties": {
                  "label": {
                    "const": "deceptive"
                  }
                },
                "type": "object"
              }
            }
          },
          "then": {
            "properties": {
              "finding": {
                "properties": {
                  "basis_flag_refs": {
                    "minItems": 1,
                    "type": "array"
                  }
                },
                "type": "object"
              }
            }
          }
        }
      ],
      "properties": {
        "schema_version": {
          "enum": [
            "deep.v1"
          ],
          "type": "string"
        },
        "as_of_turn": {
          "pattern": "^t(0[1-9]|1[0-2])$",
          "type": "string"
        },
        "finding": {
          "$ref": "#/$defs/StoredFinding"
        },
        "evidence_coverage": {
          "items": {
            "$ref": "#/$defs/CoverageEntry"
          },
          "maxItems": 8,
          "type": "array"
        },
        "open_gaps": {
          "items": {
            "$ref": "#/$defs/OpenGap"
          },
          "maxItems": 4,
          "type": "array"
        },
        "disclosure_plan": {
          "$ref": "#/$defs/DisclosurePlan"
        }
      },
      "required": [
        "schema_version",
        "as_of_turn",
        "finding",
        "evidence_coverage",
        "open_gaps",
        "disclosure_plan"
      ],
      "title": "StoredDeepUpdate",
      "type": "object"
    },
    "StoredFinding": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "label": {
                "enum": [
                  "deceptive"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "likelihood": {
                "enum": [
                  "likely",
                  "very_likely",
                  "almost_certain"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "label": {
                "enum": [
                  "truthful"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "likelihood": {
                "enum": [
                  "almost_no_chance",
                  "very_unlikely",
                  "unlikely"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "label": {
                "enum": [
                  "insufficient_evidence"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "corroboration_needed": {
                "minItems": 1,
                "type": "array"
              }
            }
          }
        }
      ],
      "properties": {
        "label": {
          "enum": [
            "deceptive",
            "truthful",
            "insufficient_evidence"
          ],
          "type": "string"
        },
        "likelihood": {
          "enum": [
            "almost_no_chance",
            "very_unlikely",
            "unlikely",
            "roughly_even_chance",
            "likely",
            "very_likely",
            "almost_certain"
          ],
          "type": "string"
        },
        "confidence": {
          "enum": [
            "low",
            "moderate",
            "high"
          ],
          "type": "string"
        },
        "basis_flag_refs": {
          "items": {
            "pattern": "^t(0[1-9]|1[0-2])\\.f[1-3]$",
            "type": "string"
          },
          "maxItems": 6,
          "type": "array",
          "uniqueItems": true
        },
        "cited_turns": {
          "items": {
            "maximum": 12,
            "minimum": 1,
            "type": "integer"
          },
          "maxItems": 12,
          "type": "array",
          "uniqueItems": true
        },
        "cited_records": {
          "items": {
            "pattern": "^(doc-0[1-4]|rec-0[1-6])$",
            "type": "string"
          },
          "maxItems": 10,
          "type": "array",
          "uniqueItems": true
        },
        "corroboration_needed": {
          "items": {
            "maxBytes": 240,
            "maxLength": 120,
            "minLength": 3,
            "type": "string"
          },
          "maxItems": 3,
          "type": "array"
        },
        "rationale": {
          "maxBytes": 1200,
          "maxLength": 600,
          "minLength": 1,
          "type": "string"
        },
        "alternative_explanations": {
          "anyOf": [
            {
              "items": {
                "maxBytes": 320,
                "maxLength": 160,
                "minLength": 3,
                "type": "string"
              },
              "maxItems": 3,
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_revised_turn": {
          "anyOf": [
            {
              "maximum": 12,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "label",
        "likelihood",
        "confidence",
        "basis_flag_refs",
        "cited_turns",
        "cited_records",
        "corroboration_needed",
        "rationale",
        "alternative_explanations",
        "last_revised_turn"
      ],
      "title": "StoredFinding",
      "type": "object"
    },
    "StoredFlag": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "missing_fact": {
                "type": "null"
              }
            }
          },
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "gap",
                  "non_responsive",
                  "possible_evasion"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "missing_fact": {
                "type": "string"
              }
            }
          }
        },
        {
          "else": {
            "properties": {
              "conflict_turn_id": {
                "type": "null"
              }
            }
          },
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "contradiction"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "conflict_turn_id": {
                "type": "string"
              }
            }
          }
        },
        {
          "else": {
            "properties": {
              "conflict_quote": {
                "type": "null"
              }
            }
          },
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "contradiction"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "conflict_quote": {
                "type": "string"
              }
            }
          }
        },
        {
          "else": {
            "properties": {
              "conflict_record_id": {
                "type": "null"
              }
            }
          },
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "evidence_conflict"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "conflict_record_id": {
                "type": "string"
              }
            }
          }
        },
        {
          "else": {
            "properties": {
              "conflict_record_quote": {
                "type": "null"
              }
            }
          },
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "evidence_conflict"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "conflict_record_quote": {
                "type": "string"
              }
            }
          }
        }
      ],
      "properties": {
        "kind": {
          "enum": [
            "gap",
            "non_responsive",
            "possible_evasion",
            "contradiction",
            "evidence_conflict"
          ],
          "type": "string"
        },
        "turn_id": {
          "pattern": "^t(0[1-9]|1[0-2])$",
          "type": "string"
        },
        "quote": {
          "description": "Exact span of the subject's answer in turn_id",
          "maxBytes": 400,
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        "missing_fact": {
          "anyOf": [
            {
              "maxBytes": 240,
              "maxLength": 120,
              "minLength": 3,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "conflict_turn_id": {
          "anyOf": [
            {
              "pattern": "^t(0[1-9]|1[0-2])$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "conflict_quote": {
          "anyOf": [
            {
              "maxBytes": 400,
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "conflict_record_id": {
          "anyOf": [
            {
              "pattern": "^(doc-0[1-4]|rec-0[1-6])$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "conflict_record_quote": {
          "anyOf": [
            {
              "maxBytes": 400,
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "flag_ref": {
          "pattern": "^t(0[1-9]|1[0-2])\\.f[1-3]$",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "turn_id",
        "quote",
        "missing_fact",
        "conflict_turn_id",
        "conflict_quote",
        "conflict_record_id",
        "conflict_record_quote",
        "flag_ref"
      ],
      "title": "StoredFlag",
      "type": "object"
    },
    "TableContent": {
      "additionalProperties": false,
      "properties": {
        "columns": {
          "items": {
            "maxLength": 40,
            "minLength": 1,
            "pattern": "^[^|\\r\\n]+$",
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "type": "array"
        },
        "rows": {
          "items": {
