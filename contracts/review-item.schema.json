{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unissant-arena.invalid/contracts/review-item.schema.json",
  "title": "ReviewItem",
  "$defs": {
    "CanonicalFact": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^f:[0-9]{2,3}$",
          "type": "string"
        },
        "statement": {
          "maxLength": 300,
          "minLength": 10,
          "type": "string"
        }
      },
      "required": [
        "id",
        "statement"
      ],
      "title": "CanonicalFact",
      "type": "object"
    },
    "CaseFile": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "maxLength": 160,
          "minLength": 1,
          "type": "string"
        },
        "investigation_objective": {
          "maxLength": 600,
          "minLength": 1,
          "type": "string"
        },
        "initial_documents": {
          "items": {
            "$ref": "#/$defs/InitialDocument"
          },
          "maxItems": 4,
          "type": "array"
        }
      },
      "required": [
        "title",
        "investigation_objective",
        "initial_documents"
      ],
      "title": "CaseFile",
      "type": "object"
    },
    "Content": {
      "additionalProperties": false,
      "properties": {
        "body": {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        },
        "table": {
          "anyOf": [
            {
              "$ref": "#/$defs/TableContent"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "body"
      ],
      "title": "Content",
      "type": "object"
    },
    "FlagItem": {
      "additionalProperties": false,
      "properties": {
        "task": {
          "const": "T-FLAG",
          "type": "string"
        },
        "item_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "type": "string"
        },
        "released": {
          "items": {
            "$ref": "#/$defs/ReviewRecord"
          },
          "maxItems": 6,
          "type": "array"
        },
        "transcript": {
          "items": {
            "$ref": "#/$defs/ReviewTurn"
          },
          "maxItems": 12,
          "type": "array"
        },
        "flags": {
          "items": {
            "$ref": "#/$defs/StoredFlag"
          },
          "maxItems": 36,
          "type": "array"
        }
      },
      "required": [
        "task",
        "item_id",
        "released",
        "transcript",
        "flags"
      ],
      "title": "FlagItem",
      "type": "object"
    },
    "Gate": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^g:[0-9]{2}$",
          "type": "string"
        },
        "condition": {
          "maxLength": 300,
          "minLength": 20,
          "type": "string"
        },
        "opens": {
          "items": {
            "pattern": "^f:[0-9]{2,3}$",
            "type": "string"
          },
          "maxItems": 4,
          "minItems": 1,
          "type": "array"
        },
        "precondition_records": {
          "items": {
            "pattern": "^(doc-0[1-4]|rec-0[1-6])$",
            "type": "string"
          },
          "maxItems": 10,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "id",
        "condition",
        "opens",
        "precondition_records"
      ],
      "title": "Gate",
      "type": "object"
    },
    "InitialDocument": {
      "additionalProperties": false,
      "properties": {
        "doc_id": {
          "pattern": "^doc-0[1-4]$",
          "type": "string"
        },
        "kind": {
          "enum": [
            "access_exception_report",
            "badge_log",
            "door_log",
            "sensor_metadata",
            "camera_metadata",
            "camera_status",
            "alarm_log",
            "monitor_alert",
            "dispatch_log",
            "work_order",
            "staffing_note",
            "visitor_register",
            "lockbox_log",
            "credential_record",
            "access_change_notice",
            "incident_ticket",
            "seal_audit",
            "witness_statement",
            "supervisor_statement",
            "email",
            "policy_excerpt",
            "procedure_excerpt",
            "facilities_notice",
            "clarification",
            "context_change"
          ],
          "type": "string"
        },
        "title": {
          "maxLength": 120,
          "minLength": 5,
          "type": "string"
        },
        "content": {
          "$ref": "#/$defs/Content"
        }
      },
      "required": [
        "doc_id",
        "kind",
        "title",
        "content"
      ],
      "title": "InitialDocument",
      "type": "object"
    },
    "LabelItem": {
      "additionalProperties": false,
      "properties": {
        "task": {
          "const": "T-LAB",
          "type": "string"
        },
        "item_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "type": "string"
        },
        "released": {
          "items": {
            "$ref": "#/$defs/ReviewRecord"
          },
          "maxItems": 6,
          "type": "array"
        },
        "transcript": {
          "items": {
            "$ref": "#/$defs/ReviewTurn"
          },
          "maxItems": 12,
          "type": "array"
        },
        "facts": {
          "items": {
            "$ref": "#/$defs/LedgerFact"
          },
          "maxItems": 30,
          "type": "array"
        },
        "uncertainty": {
          "items": {
            "$ref": "#/$defs/UncertaintyEntry"
          },
          "maxItems": 4,
          "type": "array"
        },
        "gates": {
          "items": {
            "$ref": "#/$defs/Gate"
          },
          "maxItems": 6,
          "type": "array"
        },
        "permitted_behaviors": {
          "items": {
            "enum": [
              "omission",
              "deflection",
              "minimization"
            ],
            "type": "string"
          },
          "maxItems": 3,
          "type": "array"
        },
        "canonical_facts": {
          "items": {
            "$ref": "#/$defs/CanonicalFact"
          },
          "maxItems": 40,
          "type": "array"
        }
      },
      "required": [
        "task",
        "item_id",
        "released",
        "transcript",
        "facts",
        "uncertainty",
        "gates",
        "permitted_behaviors",
        "canonical_facts"
      ],
      "title": "LabelItem",
      "type": "object"
    },
    "LedgerFact": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^f:[0-9]{2,3}$",
          "type": "string"
        },
        "fact_class": {
          "enum": [
            "FREE",
            "HOLD",
            "CORE",
            "PRIVATE"
          ],
          "type": "string"
        },
        "text": {
          "maxLength": 300,
          "minLength": 5,
          "type": "string"
        },
        "certainty": {
          "enum": [
            "certain",
            "approximate"
          ],
          "type": "string"
        },
        "gate_id": {
          "anyOf": [
            {
              "pattern": "^g:[0-9]{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "fact_class",
        "text",
        "certainty",
        "gate_id"
      ],
      "title": "LedgerFact",
      "type": "object"
    },
    "ReviewRecord": {
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "pattern": "^rec-0[1-6]$",
          "type": "string"
        },
        "title": {
          "maxLength": 120,
          "minLength": 5,
          "type": "string"
        },
        "kind": {
          "enum": [
            "record",
            "clarification",
            "context_change"
          ],
          "type": "string"
        },
        "doc_kind": {
          "anyOf": [
            {
              "enum": [
                "access_exception_report",
                "badge_log",
                "door_log",
                "sensor_metadata",
                "camera_metadata",
                "camera_status",
                "alarm_log",
                "monitor_alert",
                "dispatch_log",
                "work_order",
                "staffing_note",
                "visitor_register",
                "lockbox_log",
                "credential_record",
                "access_change_notice",
                "incident_ticket",
                "seal_audit",
                "witness_statement",
                "supervisor_statement",
                "email",
                "policy_excerpt",
                "procedure_excerpt",
                "facilities_notice",
                "clarification",
                "context_change"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "content": {
          "$ref": "#/$defs/Content"
        },
        "released_after_exchanges": {
          "maximum": 12,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "record_id",
        "title",
        "kind",
        "doc_kind",
        "content",
        "released_after_exchanges"
      ],
      "title": "ReviewRecord",
      "type": "object"
    },
    "ReviewTurn": {
      "additionalProperties": false,
      "properties": {
        "turn_no": {
          "maximum": 12,
          "minimum": 1,
          "type": "integer"
        },
        "question": {
          "maxLength": 600,
          "minLength": 1,
          "type": "string"
        },
        "answer": {
          "anyOf": [
            {
              "maxLength": 900,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "partial": {
          "type": "boolean"
        }
      },
      "required": [
        "turn_no",
        "question",
        "answer",
        "partial"
      ],
      "title": "ReviewTurn",
      "type": "object"
    },
    "RubricItem": {
      "additionalProperties": false,
      "properties": {
        "task": {
          "const": "T-RUB",
          "type": "string"
        },
        "item_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "type": "string"
        },
        "instrument": {
          "enum": [
            "C-RUB",
            "C-QQ"
          ],
          "type": "string"
        },
        "case_file": {
          "$ref": "#/$defs/CaseFile"
        },
        "released": {
          "items": {
            "$ref": "#/$defs/ReviewRecord"
          },
          "maxItems": 6,
          "type": "array"
        },
        "transcript": {
          "items": {
            "$ref": "#/$defs/ReviewTurn"
          },
          "maxItems": 12,
          "type": "array"
        },
        "questions": {
          "items": {
            "$ref": "#/$defs/ScoredQuestion"
          },
          "maxItems": 12,
          "type": "array"
        },
        "finding": {
          "anyOf": [
            {
              "$ref": "#/$defs/StoredFinding"
            },
            {
              "type": "null"
            }
          ]
        },
        "triggers": {
          "items": {
            "$ref": "#/$defs/TriggerEntry"
          },
          "maxItems": 60,
          "type": "array"
        }
      },
      "required": [
        "task",
        "item_id",
        "instrument",
        "case_file",
        "released",
        "transcript",
        "questions",
        "finding",
        "triggers"
      ],
      "title": "RubricItem",
      "type": "object"
    },
    "ScoredQuestion": {
      "additionalProperties": false,
      "properties": {
        "turn_no": {
          "maximum": 12,
          "minimum": 1,
          "type": "integer"
        },
        "question": {
          "maxLength": 600,
          "minLength": 1,
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "enum": [
                "investigator",
                "harness_fixed",
                "harness_fallback",
                "assistant_relay"
              ],
              "type": "string"
            },
            {
              "const": "assistant_proposal",
              "type": "string"
            }
          ]
        }
      },
      "required": [
        "turn_no",
        "question",
        "source"
      ],
      "title": "ScoredQuestion",
      "type": "object"
    },
    "StoredFinding": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "enum": [
            "deceptive",
            "truthful",
            "insufficient_evidence"
          ],
          "type": "string"
        },
        "likelihood": {
          "enum": [
            "almost_no_chance",
            "very_unlikely",
            "unlikely",
            "roughly_even_chance",
            "likely",
            "very_likely",
            "almost_certain"
          ],
          "type": "string"
        },
        "confidence": {
          "enum": [
            "low",
            "moderate",
            "high"
          ],
          "type": "string"
        },
        "basis_flag_refs": {
          "items": {
            "pattern": "^t(0[1-9]|1[0-2])\\.f[1-3]$",
            "type": "string"
          },
          "maxItems": 6,
          "type": "array"
        },
        "cited_turns": {
          "items": {
            "maximum": 12,
            "minimum": 1,
            "type": "integer"
          },
          "maxItems": 12,
          "type": "array"
        },
        "cited_records": {
          "items": {
            "pattern": "^(doc-0[1-4]|rec-0[1-6])$",
            "type": "string"
          },
          "maxItems": 10,
          "type": "array"
        },
        "corroboration_needed": {
          "items": {
            "maxLength": 120,
            "minLength": 3,
            "type": "string"
          },
          "maxItems": 3,
          "type": "array"
        },
        "rationale": {
          "maxLength": 600,
          "minLength": 1,
          "type": "string"
        },
        "alternative_explanations": {
          "anyOf": [
            {
              "items": {
                "maxLength": 160,
                "minLength": 3,
                "type": "string"
              },
              "maxItems": 3,
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_revised_turn": {
          "anyOf": [
            {
              "maximum": 12,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "label",
        "likelihood",
        "confidence",
        "basis_flag_refs",
        "cited_turns",
        "cited_records",
        "corroboration_needed",
        "rationale",
        "alternative_explanations",
        "last_revised_turn"
      ],
      "title": "StoredFinding",
      "type": "object"
    },
    "StoredFlag": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "gap",
            "non_responsive",
            "possible_evasion",
            "contradiction",
            "evidence_conflict"
          ],
          "type": "string"
        },
        "turn_id": {
          "pattern": "^t(0[1-9]|1[0-2])$",
          "type": "string"
        },
        "quote": {
          "description": "Exact span of the subject's answer in turn_id",
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        "missing_fact": {
          "anyOf": [
            {
              "maxLength": 120,
              "minLength": 3,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "conflict_turn_id": {
          "anyOf": [
            {
              "pattern": "^t(0[1-9]|1[0-2])$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "conflict_quote": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "conflict_record_id": {
          "anyOf": [
            {
              "pattern": "^(doc-0[1-4]|rec-0[1-6])$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "conflict_record_quote": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "flag_ref": {
          "pattern": "^t(0[1-9]|1[0-2])\\.f[1-3]$",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "turn_id",
        "quote",
        "missing_fact",
        "conflict_turn_id",
        "conflict_quote",
        "conflict_record_id",
        "conflict_record_quote",
        "flag_ref"
      ],
      "title": "StoredFlag",
      "type": "object"
    },
    "TableContent": {
      "additionalProperties": false,
      "properties": {
        "columns": {
          "items": {
            "maxLength": 40,
            "minLength": 1,
            "pattern": "^[^|\\r\\n]+$",
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "type": "array"
        },
        "rows": {
          "items": {
            "items": {
              "maxLength": 200,
              "pattern": "^[^|\\r\\n]*$",
              "type": "string"
            },
            "maxItems": 8,
            "minItems": 1,
            "type": "array"
          },
          "maxItems": 30,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "columns",
        "rows"
      ],
      "title": "TableContent",
      "type": "object"
    },
    "TriggerEntry": {
      "additionalProperties": false,
      "properties": {
        "subcheck_id": {
          "pattern": "^[1-5][a-e]$",
          "type": "string"
        },
        "trigger_turns": {
          "items": {
            "maximum": 12,
            "minimum": 1,
            "type": "integer"
          },
          "maxItems": 2,
          "type": "array"
        },
        "trigger_record": {
          "anyOf": [
            {
              "pattern": "^(doc-0[1-4]|rec-0[1-6])$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "question_turns": {
          "items": {
            "maximum": 12,
            "minimum": 1,
            "type": "integer"
          },
          "maxItems": 12,
          "type": "array"
        }
      },
      "required": [
        "subcheck_id",
        "trigger_turns",
        "trigger_record",
        "question_turns"
      ],
      "title": "TriggerEntry",
      "type": "object"
    },
    "UncertaintyEntry": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^u:[0-9]{2}$",
          "type": "string"
        },
        "fact_id": {
          "pattern": "^f:[0-9]{2,3}$",
          "type": "string"
        },
        "text": {
          "maxLength": 300,
          "minLength": 10,
          "type": "string"
        }
      },
      "required": [
        "id",
        "fact_id",
        "text"
      ],
      "title": "UncertaintyEntry",
      "type": "object"
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/RubricItem"
    },
    {
      "$ref": "#/$defs/LabelItem"
    },
    {
      "$ref": "#/$defs/FlagItem"
    }
  ]
}
