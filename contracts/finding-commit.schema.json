{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unissant-arena.invalid/contracts/finding-commit.schema.json",
  "title": "FindingCommit",
  "$defs": {
    "InvestigatorFinding": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "label": {
                "enum": [
                  "deceptive"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "likelihood": {
                "enum": [
                  "likely",
                  "very_likely",
                  "almost_certain"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "label": {
                "enum": [
                  "truthful"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "likelihood": {
                "enum": [
                  "almost_no_chance",
                  "very_unlikely",
                  "unlikely"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "label": {
                "enum": [
                  "insufficient_evidence"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "corroboration_needed": {
                "minItems": 1,
                "type": "array"
              }
            }
          }
        }
      ],
      "properties": {
        "label": {
          "enum": [
            "deceptive",
            "truthful",
            "insufficient_evidence"
          ],
          "type": "string"
        },
        "likelihood": {
          "enum": [
            "almost_no_chance",
            "very_unlikely",
            "unlikely",
            "roughly_even_chance",
            "likely",
            "very_likely",
            "almost_certain"
          ],
          "type": "string"
        },
        "confidence": {
          "enum": [
            "low",
            "moderate",
            "high"
          ],
          "type": "string"
        },
        "basis_flag_refs": {
          "items": {
            "pattern": "^t(0[1-9]|1[0-2])\\.f[1-3]$",
            "type": "string"
          },
          "maxItems": 0,
          "type": "array"
        },
        "cited_turns": {
          "items": {
            "maximum": 12,
            "minimum": 1,
            "type": "integer"
          },
          "maxItems": 12,
          "type": "array",
          "uniqueItems": true
        },
        "cited_records": {
          "items": {
            "pattern": "^(doc-0[1-4]|rec-0[1-6])$",
            "type": "string"
          },
          "maxItems": 10,
          "type": "array",
          "uniqueItems": true
        },
        "corroboration_needed": {
          "items": {
            "maxBytes": 240,
            "maxLength": 120,
            "minLength": 3,
            "type": "string"
          },
          "maxItems": 3,
          "type": "array"
        },
        "rationale": {
          "maxBytes": 1200,
          "maxLength": 600,
          "minLength": 1,
          "type": "string"
        },
        "alternative_explanations": {
          "anyOf": [
            {
              "items": {
                "maxBytes": 320,
                "maxLength": 160,
                "minLength": 3,
                "type": "string"
              },
              "maxItems": 3,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "label",
        "likelihood",
        "confidence",
        "basis_flag_refs",
        "cited_turns",
        "cited_records",
        "corroboration_needed",
        "rationale"
      ],
      "title": "InvestigatorFinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "finding": {
      "$ref": "#/$defs/InvestigatorFinding"
    },
    "idem_key": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    }
  },
  "required": [
    "finding",
    "idem_key"
  ],
  "type": "object"
}
