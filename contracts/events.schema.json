          ]
        },
        "seq": {
          "minimum": 1,
          "type": "integer"
        },
        "type": {
          "const": "evidence.released",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/EvidenceReleased"
        }
      },
      "required": [
        "v",
        "scope",
        "scope_id",
        "ts",
        "transcript_version",
        "seq",
        "type",
        "data"
      ],
      "title": "EvidenceReleasedFrame",
      "type": "object"
    },
    "FindingCommitted": {
      "additionalProperties": false,
      "properties": {
        "by": {
          "enum": [
            "investigator",
            "assistant"
          ],
          "type": "string"
        },
        "finding": {
          "$ref": "#/$defs/StoredFinding"
        },
        "committed_at": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|[+-][0-9]{2}:[0-9]{2})$",
          "type": "string"
        }
      },
      "required": [
