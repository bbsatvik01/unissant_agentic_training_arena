{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unissant-arena.invalid/contracts/events.schema.json",
  "title": "TrialFrame",
  "$defs": {
    "CardValidation": {
      "additionalProperties": false,
      "properties": {
        "valid": {
          "type": "boolean"
        },
        "flags": {
          "additionalProperties": false,
          "maxProperties": 3,
          "patternProperties": {
            "^t(0[1-9]|1[0-2])\\.f[1-3]$": {
              "$ref": "#/$defs/FlagCheck"
            }
          },
          "type": "object"
        },
        "demeanor_in_rationale": {
          "type": "boolean"
        }
      },
      "required": [
        "valid",
        "flags",
        "demeanor_in_rationale"
      ],
      "title": "CardValidation",
      "type": "object"
    },
    "CoachCard": {
      "additionalProperties": false,
      "properties": {
        "turn_no": {
          "maximum": 12,
          "minimum": 1,
          "type": "integer"
        },
        "card": {
          "$ref": "#/$defs/TrainingWireCard"
        }
      },
      "required": [
        "turn_no",
        "card"
      ],
      "title": "CoachCard",
      "type": "object"
    },
    "CoachCardFrame": {
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1,
          "type": "integer"
        },
        "scope": {
          "const": "trial",
          "type": "string"
        },
        "scope_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "type": "string"
        },
        "ts": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|[+-][0-9]{2}:[0-9]{2})$",
          "type": "string"
        },
        "transcript_version": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "seq": {
          "minimum": 1,
          "type": "integer"
        },
        "type": {
          "const": "coach.card",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/CoachCard"
        }
      },
      "required": [
        "v",
        "scope",
        "scope_id",
        "ts",
        "transcript_version",
        "seq",
        "type",
        "data"
      ],
      "title": "CoachCardFrame",
      "type": "object"
    },
    "CoachFailed": {
      "additionalProperties": false,
      "properties": {
        "turn_no": {
          "maximum": 12,
          "minimum": 1,
          "type": "integer"
        },
        "reason": {
          "enum": [
            "timeout",
            "repair_failed"
          ],
          "type": "string"
        }
      },
      "required": [
        "turn_no",
        "reason"
      ],
      "title": "CoachFailed",
      "type": "object"
    },
    "CoachFailedFrame": {
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1,
          "type": "integer"
        },
        "scope": {
          "const": "trial",
          "type": "string"
        },
        "scope_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "type": "string"
        },
        "ts": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|[+-][0-9]{2}:[0-9]{2})$",
          "type": "string"
        },
        "transcript_version": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "seq": {
          "minimum": 1,
          "type": "integer"
        },
        "type": {
          "const": "coach.failed",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/CoachFailed"
        }
      },
      "required": [
        "v",
        "scope",
        "scope_id",
        "ts",
        "transcript_version",
        "seq",
        "type",
        "data"
      ],
      "title": "CoachFailedFrame",
      "type": "object"
    },
    "CoachUpdate": {
      "additionalProperties": false,
      "properties": {
        "turn_no": {
          "maximum": 12,
          "minimum": 1,
          "type": "integer"
        },
        "update": {
          "$ref": "#/$defs/StoredDeepUpdate"
        }
      },
      "required": [
        "turn_no",
        "update"
      ],
      "title": "CoachUpdate",
      "type": "object"
    },
    "CoachUpdateFrame": {
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1,
          "type": "integer"
        },
        "scope": {
          "const": "trial",
          "type": "string"
        },
        "scope_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "type": "string"
        },
        "ts": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|[+-][0-9]{2}:[0-9]{2})$",
          "type": "string"
        },
        "transcript_version": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "seq": {
          "minimum": 1,
          "type": "integer"
        },
        "type": {
          "const": "coach.update",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/CoachUpdate"
        }
      },
      "required": [
        "v",
        "scope",
        "scope_id",
        "ts",
        "transcript_version",
        "seq",
        "type",
        "data"
      ],
      "title": "CoachUpdateFrame",
      "type": "object"
    },
    "CoachWorkingFrame": {
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1,
          "type": "integer"
        },
        "scope": {
          "const": "trial",
          "type": "string"
        },
        "scope_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "type": "string"
        },
        "ts": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|[+-][0-9]{2}:[0-9]{2})$",
          "type": "string"
        },
        "transcript_version": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "seq": {
          "type": "null"
        },
        "type": {
          "const": "coach.working",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/TurnRef"
        }
      },
      "required": [
        "v",
        "scope",
        "scope_id",
        "ts",
        "transcript_version",
        "seq",
        "type",
        "data"
      ],
      "title": "CoachWorkingFrame",
      "type": "object"
    },
    "Content": {
      "additionalProperties": false,
      "properties": {
        "body": {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        },
        "table": {
          "anyOf": [
            {
              "$ref": "#/$defs/TableContent"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "body"
      ],
      "title": "Content",
      "type": "object"
    },
    "CoverageEntry": {
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "pattern": "^rec-0[1-6]$",
          "type": "string"
        },
        "status": {
          "enum": [
            "not_yet_raised",
            "raised_not_tested",
            "consistent_with_account",
            "conflicts_with_account",
            "explained_innocently"
          ],
          "type": "string"
        },
        "turn_ids": {
          "items": {
            "pattern": "^t(0[1-9]|1[0-2])$",
            "type": "string"
          },
          "maxItems": 4,
          "type": "array"
        }
      },
      "required": [
        "record_id",
        "status",
        "turn_ids"
      ],
      "title": "CoverageEntry",
      "type": "object"
    },
    "DebriefReady": {
      "additionalProperties": false,
      "properties": {
        "session_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "type": "string"
        }
      },
      "required": [
        "session_id"
      ],
      "title": "DebriefReady",
      "type": "object"
    },
    "DebriefReadyFrame": {
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1,
          "type": "integer"
        },
        "scope": {
          "const": "trial",
          "type": "string"
        },
        "scope_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "type": "string"
        },
        "ts": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|[+-][0-9]{2}:[0-9]{2})$",
          "type": "string"
        },
        "transcript_version": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "seq": {
          "minimum": 1,
          "type": "integer"
        },
        "type": {
          "const": "debrief.ready",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/DebriefReady"
        }
      },
      "required": [
        "v",
        "scope",
        "scope_id",
        "ts",
        "transcript_version",
        "seq",
        "type",
        "data"
      ],
      "title": "DebriefReadyFrame",
      "type": "object"
    },
    "DisclosurePlan": {
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "anyOf": [
            {
              "pattern": "^rec-0[1-6]$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "step": {
          "enum": [
            "hold",
            "evidence_topic",
            "evidence_source_vague",
            "evidence_specific"
          ],
          "type": "string"
        }
      },
      "required": [
        "record_id",
        "step"
      ],
      "title": "DisclosurePlan",
      "type": "object"
    },
    "EvidenceReleased": {
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "pattern": "^rec-0[1-6]$",
          "type": "string"
        },
        "title": {
          "maxLength": 120,
          "minLength": 5,
          "type": "string"
        },
        "kind": {
          "enum": [
            "record",
            "clarification",
            "context_change"
          ],
          "type": "string"
        },
        "doc_kind": {
          "anyOf": [
            {
              "enum": [
                "access_exception_report",
                "badge_log",
                "door_log",
                "sensor_metadata",
                "camera_metadata",
                "camera_status",
                "alarm_log",
                "monitor_alert",
                "dispatch_log",
                "work_order",
                "staffing_note",
                "visitor_register",
                "lockbox_log",
                "credential_record",
                "access_change_notice",
                "incident_ticket",
                "seal_audit",
                "witness_statement",
                "supervisor_statement",
                "email",
                "policy_excerpt",
                "procedure_excerpt",
                "facilities_notice",
                "clarification",
                "context_change"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "date": {
          "anyOf": [
            {
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "content": {
          "$ref": "#/$defs/Content"
        },
        "released_at_turn": {
          "maximum": 12,
          "minimum": 0,
          "type": "integer"
        },
        "trigger": {
          "enum": [
            "scheduled",
            "requested"
          ],
          "type": "string"
        }
      },
      "required": [
        "record_id",
        "title",
        "kind",
        "doc_kind",
        "date",
        "content",
        "released_at_turn",
        "trigger"
      ],
      "title": "EvidenceReleased",
      "type": "object"
    },
    "EvidenceReleasedFrame": {
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1,
