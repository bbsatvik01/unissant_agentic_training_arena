        },
        "seq": {
          "minimum": 1,
          "type": "integer"
        },
        "type": {
          "const": "finding.committed",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/FindingCommitted"
        }
      },
      "required": [
        "v",
        "scope",
        "scope_id",
        "ts",
        "transcript_version",
        "seq",
        "type",
        "data"
      ],
      "title": "FindingCommittedFrame",
      "type": "object"
    },
    "FlagCheck": {
      "additionalProperties": false,
      "properties": {
        "citation_ok": {
          "type": "boolean"
        },
        "demeanor_based": {
          "type": "boolean"
        },
        "duplicate": {
          "type": "boolean"
        }
      },
      "required": [
        "citation_ok",
        "demeanor_based",
        "duplicate"
      ],
      "title": "FlagCheck",
      "type": "object"
    },
    "FollowUp": {
      "additionalProperties": false,
      "properties": {
        "question": {
          "maxLength": 300,
          "minLength": 1,
          "type": "string"
        },
        "tactic": {
          "enum": [
            "account_first_open",
            "funnel_probe",
            "evidence_topic",
            "evidence_source_vague",
            "evidence_specific",
            "unanticipated_detail",
            "reverse_order",
            "verifiable_detail",
            "clarify_contradiction",
            "alternative_explanation",
            "corroboration_request",
            "summary_check"
          ],
          "type": "string"
        },
        "purpose": {
          "maxLength": 160,
          "minLength": 1,
          "type": "string"
        },
        "record_request": {
          "anyOf": [
            {
              "pattern": "^rec-0[1-6]$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "question",
        "tactic",
        "purpose",
        "record_request"
      ],
      "title": "FollowUp",
      "type": "object"
    },
    "Notice": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "paused",
            "quota"
          ],
          "type": "string"
        },
        "text": {
          "maxLength": 300,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "kind",
        "text"
      ],
      "title": "Notice",
      "type": "object"
    },
    "NoticeFrame": {
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1,
          "type": "integer"
        },
        "scope": {
          "const": "trial",
          "type": "string"
        },
        "scope_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
