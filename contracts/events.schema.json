      "required": [
        "v",
        "scope",
        "scope_id",
        "ts",
        "transcript_version",
        "seq",
        "type",
        "data"
      ],
      "title": "NoticeFrame",
      "type": "object"
    },
    "OpenGap": {
      "additionalProperties": false,
      "properties": {
        "missing_fact": {
          "maxLength": 120,
          "minLength": 3,
          "type": "string"
        },
        "first_seen_turn": {
          "pattern": "^t(0[1-9]|1[0-2])$",
          "type": "string"
        }
      },
      "required": [
        "missing_fact",
        "first_seen_turn"
      ],
      "title": "OpenGap",
      "type": "object"
    },
    "Question": {
      "additionalProperties": false,
      "properties": {
        "question_type": {
          "enum": [
            "open",
            "probing",
            "closed",
            "leading",
            "suggestive",
            "compound",
            "forced_choice",
            "opinion"
          ],
          "type": "string"
        },
        "neutrality_issues": {
          "items": {
            "enum": [
              "presupposes_fact",
              "accusatory_wording",
              "demeanor_reference",
              "multiple_questions",
              "limits_options",
              "solicits_opinion",
              "emotionally_loaded",
              "pressure_or_inducement"
            ],
            "type": "string"
          },
          "maxItems": 4,
          "type": "array"
        },
        "assessment": {
          "description": "One sentence on the question",
          "maxLength": 160,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "question_type",
        "neutrality_issues",
        "assessment"
      ],
      "title": "Question",
      "type": "object"
    },
