# Secrets: every env file (.env, .env.local, .env.local.public|subject|referee, ...) except the committed
# example shapes; keys and keystores. tools/check_push_clean.py fails if one is ever tracked anyway.
.env
.env.*
!.env.example
!.env.local.example
*.pem
*.key

# Hidden case families (D-014): authored by isolated agents into this directory, never committed, never
# read by the team or a gate (tools/check_push_clean.py also refuses any tracked path under it).
cases/hidden/

# Gate tooling outputs: pinned security binaries, coverage, SARIF, exported requirements, CodeQL databases.
.tools/
.gates/
.coverage
.coverage.*
coverage.xml
htmlcov/
coverage/

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/
*.egg-info/

# Node
node_modules/
.next/

# Scratch
scratch/
tmp/

# OS / editor
.DS_Store
.idea/
.vscode/

# Local stack state (scripts/dev.sh): caller tokens, pidfile, the generated allowlist.
.run/

# Run recordings (D-021, make export-run); only the committed samples are tracked (real-F01: a real-model run).
recordings/*
!recordings/sample-F01.json
!recordings/real-F01.json
!recordings/real-F01-deceptive-coached.json
!recordings/real-F02-truthful-coached.json
