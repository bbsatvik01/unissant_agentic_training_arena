      "peak": 0.961395263671875,
      "rms": 0.11623228055753464,
      "settings": {
        "voice": "en-gb",
        "words_per_minute": 148,
        "pitch": 38,
        "amplitude": 135
      }
    },
    {
      "id": "sergeant-clarify",
      "voice_id": "local-sergeant-v1",
      "text": "Ask one neutral question at a time. Separate what the person directly observed from what they heard, inferred, or do not remember. Do not fill in missing details for them.",
      "url": "/audio/staff-v1/sergeant-clarify.wav",
      "sha256": "74669b58abaf04259539982654ce3fa61649832fbd0c0cb6a368ed8338a7aa09",
      "bytes": 510472,
      "duration_seconds": 11.574331065759637,
      "sample_rate": 22050,
      "peak": 0.996734619140625,
      "rms": 0.11459534844674263,
      "settings": {
        "voice": "en-gb",
        "words_per_minute": 148,
        "pitch": 38,
        "amplitude": 135
      }
    },
    {
      "id": "sergeant-evidence",
      "voice_id": "local-sergeant-v1",
      "text": "Keep observations, statements, and your interpretations separate. Check a claim against the available records or corroborating information, and record uncertainty when support is incomplete.",
      "url": "/audio/staff-v1/sergeant-evidence.wav",
      "sha256": "c6fcef4d37122219802836ca27d7c1df773f87b9ac5dca0f26a10d47618e3712",
      "bytes": 581426,
      "duration_seconds": 13.183265306122449,
      "sample_rate": 22050,
      "peak": 0.998931884765625,
      "rms": 0.10945411808017003,
      "settings": {
        "voice": "en-gb",
        "words_per_minute": 148,
        "pitch": 38,
        "amplitude": 135
      }
    },
    {
      "id": "sergeant-demeanor",
      "voice_id": "local-sergeant-v1",
      "text": "Do not treat accent, pauses, stress, nervousness, eye contact, or appearance as evidence of truth or deception. Use the content of statements and independently checkable information.",
