    {
      "id": "sergeant-opening",
      "voice_id": "local-sergeant-v1",
      "text": "Start with an invitation such as, “Please walk me through what you remember, from the beginning.” Give the person room to answer before narrowing the question.",
      "url": "/audio/staff-v1/sergeant-opening.wav",
      "sha256": "3455ac577efa5854276dd6ecf0683a8aa768bddec35533f7396a412ad04ddf75",
      "bytes": 449078,
      "duration_seconds": 10.182176870748298,
