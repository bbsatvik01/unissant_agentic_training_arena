# Shape of the local settings (S5 10.2). Placeholder values only. Copy this block to .env.local
# (git-ignored); it holds shared settings and never a *_DSN key (scripts/run_local.py, WP-13, refuses a
# .env.local that contains one).
ARENA_ENV=local
ARENA_GCP_PROJECT=replace-with-the-arena-gcp-project-id
VERTEX_IMPERSONATE_SERVICE_ACCOUNT=replace-with-the-arena-service-account-email
ARENA_MODEL_MODE=fake
ARENA_DEV_USER=replace-with-an-allowlisted-email
ARENA_USERS_FILE=replace-with-the-path-of-the-git-ignored-users-toml
ARENA_CASE_DRAW_SEED=replace-with-an-integer
PHOENIX_OTLP_ENDPOINT=http://127.0.0.1:6006
PHOENIX_API_KEY=replace-me
# Optional; local runs accept 127.0.0.1 only (S5 1.3), and it is the default when unset.
# ARENA_BIND_HOST=127.0.0.1

# The three per-credential files, each git-ignored, mode 0600, holding exactly ONE line (S5 10.2):
#   .env.local.public   ARENA_PUBLIC_DSN=postgresql://arena_public:REPLACE_ME@<host>:<port>/postgres
#   .env.local.subject  ARENA_SUBJECT_DSN=postgresql://arena_subject:REPLACE_ME@<host>:<port>/postgres
#   .env.local.referee  ARENA_REFEREE_DSN=postgresql://arena_referee:REPLACE_ME@<host>:<port>/postgres
# scripts/run_local.py gives arena-api and arena-tournament the public file, arena-subject the subject file
# and arena-referee the referee file; ARENA_ROLE is set per child by the launcher, never here.
#
# Never in any .env.local* file and never in a running role: ARENA_OWNER_DSN (operator shell only, for one
# command), GOOGLE_API_KEY, GEMINI_API_KEY (the boot checks refuse them; Vertex AI uses ADC only).
