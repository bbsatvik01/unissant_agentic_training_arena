# Shape of the local settings (S5 10.2). Placeholder values only; copy to .env.local (git-ignored) and fill in.
# Each role process receives exactly ONE of the three DSNs, from its own file; never put them all in one env.
ARENA_ENV=local
ARENA_GCP_PROJECT=replace-with-arena-gcp-project-id
ARENA_ROLE=api

# Per-role credential files (one DSN each), e.g. .env.api, .env.subject, .env.referee:
ARENA_PUBLIC_DSN=postgresql://arena_public:REPLACE_ME@127.0.0.1:5432/postgres
# ARENA_SUBJECT_DSN=postgresql://arena_subject:REPLACE_ME@127.0.0.1:5432/postgres
# ARENA_REFEREE_DSN=postgresql://arena_referee:REPLACE_ME@127.0.0.1:5432/postgres

# Never set in a running role: ARENA_OWNER_DSN, GOOGLE_API_KEY, GEMINI_API_KEY (boot checks refuse them).
# Vertex AI uses Application Default Credentials only.
