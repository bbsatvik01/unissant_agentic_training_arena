# Shape of the local settings (S5 10.2). Placeholder values only. Copy this block to .env.local
# (git-ignored); it holds shared settings and never a *_DSN key (scripts/run_local.py, WP-13, refuses a
# .env.local that contains one).
ARENA_ENV=local
# D-015: the boot checks accept exactly this project and refuse every other value.
ARENA_GCP_PROJECT=cna-guardian
# Local impersonation only (S5 10.2); every call still carries labels={"app": "unissant-arena"} regardless
# (arena_core.providers.types.APP_LABELS, D-015 S5 3.2 step 4) -- that label is not configured here, it is
# code. Leave this set, or blank, in both fake and real mode: real mode just needs it to name a real,
# impersonable service account if impersonation is used; fake mode never reads it.
VERTEX_IMPERSONATE_SERVICE_ACCOUNT=replace-with-the-arena-service-account-email
# fake: FakeAdapter, zero spend, every test and make dev-local. Real Vertex calls (make dev against the root
# Supabase env, make real-smoke): delete this line, or set it to `vertex` (the default when unset) --
# nothing else in this file changes. A real call still needs, outside this file: `gcloud auth
# application-default login` run once by the operator (ADC; arena_core.providers.vertex reads it through
# google.auth.default(), never a key file this file would name -- D-001 forbids GOOGLE_API_KEY and
# GEMINI_API_KEY outright) and the candidates already registered (make seed-hosted), whose manifests name
# the model per call type (prompts/manifests/*.json limits.*.model_id); no model id is configured here.
ARENA_MODEL_MODE=fake
ARENA_DEV_USER=replace-with-an-allowlisted-email
ARENA_USERS_FILE=replace-with-the-path-of-the-git-ignored-users-toml
ARENA_CASE_DRAW_SEED=replace-with-an-integer
PHOENIX_OTLP_ENDPOINT=http://127.0.0.1:6006
PHOENIX_API_KEY=replace-me
# Optional (WP-13): the training session's coach and subject candidates (default A1 and S1), and extra browser
# origins arena-api accepts on a POST (default: the Vite dev origin, http://127.0.0.1:5173 and localhost:5173).
# ARENA_TRAINING_COACH=A1
# ARENA_TRAINING_SUBJECT=S1
# ARENA_BROWSER_ORIGINS=http://127.0.0.1:5173
# Optional; local runs accept 127.0.0.1 only (S5 1.3), and it is the default when unset.
# ARENA_BIND_HOST=127.0.0.1
# Optional (S5 8.1, 8.6); default "arena" when unset. The arizephoenix/phoenix project name spans land in.
# PHOENIX_PROJECT=arena
# Optional (S5 8.5); the tournament job sets this to withhold every span from the direct exporter (a hidden,
# unrevealed tournament relies on this, not on PHOENIX_OTLP_ENDPOINT being unset). Unset elsewhere.
# ARENA_TRACE_EXPORT=mirror_only

# The three per-credential files, each git-ignored, mode 0600, holding exactly ONE line (S5 10.2):
#   .env.local.public   ARENA_PUBLIC_DSN=postgresql://arena_public:REPLACE_ME@<host>:<port>/postgres
#   .env.local.subject  ARENA_SUBJECT_DSN=postgresql://arena_subject:REPLACE_ME@<host>:<port>/postgres
#   .env.local.referee  ARENA_REFEREE_DSN=postgresql://arena_referee:REPLACE_ME@<host>:<port>/postgres
# scripts/run_local.py gives arena-api and arena-tournament the public file, arena-subject the subject file
# and arena-referee the referee file; ARENA_ROLE is set per child by the launcher, never here.
#
# Never in any .env.local* file and never in a running role: ARENA_OWNER_DSN (operator shell only, for one
# command), GOOGLE_API_KEY, GEMINI_API_KEY (the boot checks refuse them; Vertex AI uses ADC only).
#
# make seed-hosted (ARENA_OWNER_DSN in the shell, never here) and make real-smoke (.env.local plus
# .env.local.public and .env.local.subject, the same two files `make dev` already reads) need no file or
# variable beyond what is already named above.
